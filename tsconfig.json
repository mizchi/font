{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true
  },
  "include": ["browser/**/*", "tests/browser/**/*", "scripts/browser-server.ts", "scripts/measure-browser.ts", "scripts/check-fit.ts", "playwright.config.ts"]
}
