name = "mizchi/font"

version = "0.8.0"

import {
  "mizchi/svg@0.2.3",
  "mizchi/pixelmatch@0.6.2",
  "mizchi/zlib@0.4.10",
  "mizchi/brotli@0.2.2",
  "moonbitlang/x@0.5.7",
  "moonbit-community/unicode-bidi@0.7.1",
  "Milky2018/moon_swash@0.1.15",
}

readme = "README.md"

repository = "https://github.com/mizchi/font"

license = "Apache-2.0"

keywords = [
  "font",
  "ttf",
  "woff",
  "woff2",
  "opentype",
  "otf",
  "cff",
  "shaping",
  "text-layout",
]

description = "OpenType font parsing, shaping and text bounds for MoonBit"

source = "src"
