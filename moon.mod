name = "mizchi/font"

version = "0.7.4"

import {
  "mizchi/svg@0.2.3",
  "mizchi/pixelmatch@0.6.1",
  "mizchi/zlib@0.4.9",
  "mizchi/brotli@0.2.2",
  "moonbitlang/x@0.4.50",
}

readme = "README.md"

repository = "https://github.com/mizchi/font"

license = "Apache-2.0"

keywords = [ "font", "ttf", "woff", "woff2", "opentype", "otf", "cff" ]

description = "TrueType/OTF(CFF)/WOFF/WOFF2 font parser for MoonBit"

source = "src"
